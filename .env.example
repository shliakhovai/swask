# Server-only settings. Never use VITE_ for secrets.
DATABASE_URL=
SWASK_SYNC_KEY=
# npm run setup generates a matching VAPID pair; keep it stable after subscribing.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://github.com/shliakhovai/swask
# Optional; defaults: dev 127.0.0.1:5173, production 0.0.0.0:4173.
HOST=
PORT=
